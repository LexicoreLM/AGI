# Database
DORIM_DB_HOST=localhost
DORIM_DB_PORT=5432
DORIM_DB_USER=agent
DORIM_DB_PASSWORD=pass
DORIM_DB_NAME=service_recognition
DORIM_SOURCE_SCHEMA=service_recognition
DORIM_ENGINE_SCHEMA=recognition_engine

# API
DORIM_API_HOST=0.0.0.0
DORIM_API_PORT=8000
DORIM_API_WORKERS=1
DORIM_MAX_UPLOAD_MB=50

# Matching
DORIM_CANDIDATE_LIMIT=200
DORIM_W_FUZZY=0.40
DORIM_W_TFIDF=0.30
DORIM_W_MAKER=0.20
DORIM_W_DOSAGE=0.10
DORIM_LOW_CONFIDENCE_THRESHOLD=0.55

# Logging
DORIM_LOG_LEVEL=INFO
